{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "NodeNext", // Modern ESM for Node.js
    "target": "ESNext", // Latest JS features
    "moduleResolution": "NodeNext", // Required for ESM
    "types": ["node"], // Keep if using Node.js types
    "lib": ["ESNext"], // Modern JS APIs

    // Output Settings
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Strict Type-Checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // ESM & TSX Compatibility
    "verbatimModuleSyntax": true, // Explicit ESM imports
    "isolatedModules": true, // Required for `tsx`
    "jsx": "react-jsx", // Only if using React
    "skipLibCheck": true // Faster builds
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
